      "contains": [
        "step 1/1"
      ]
    },
    {
      "after": 6,
      "page": "play",
      "contains": [
        "step 1/1"
      ]
    },
    {
      "after": 7,
      "focus": "index-player",
      "contains": [
        "step 1/1"
      ]
    },
    {
      "after": 8,
      "focus": "s1",
      "contains": [
        "First frame"
      ]
    },
    {
      "focus": "s0",
